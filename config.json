{
  "schemaVersion": 1,
  "revision": 12,
  "updatedAt": "2026-10-01",
  "remoteConfigUrl": "https://raw.githubusercontent.com/h3b3rt/Extension_Amazon_CF_Scrapping/main/config.json",
  "minExtensionVersion": "1.1.0",
  "latestVersion": "1.7.0",
  "downloadUrl": "https://github.com/h3b3rt/Extension_Amazon_CF_Scrapping/releases/latest",
  "notice": "",

  "categoriesUrl": "https://raw.githubusercontent.com/h3b3rt/Extension_Amazon_CF_Scrapping/main/categories.json",

  "productUrl": "https://www.amazon.com/dp/{asin}",

  "scroll": { "stepDelayMs": 350, "maxSteps": 80 },

  "image": { "fullSize": true },

  "history": {
    "keepParams": ["k", "i", "rh", "page", "node", "bbn", "s", "field-keywords", "low-price", "high-price", "me", "srs"]
  },

  "pageBrand": {
    "urlPattern": "^/stores/",
    "selectors": ["nav[data-testid=\"breadcrumb\"] li:first-child [itemprop=\"name\"]", "[data-testid=\"header-logo\"] img[alt$=\" home page\"]"],
    "strip": " home page$",
    "scriptPattern": "\"brandName\":\"([^\"]+)\""
  },

  "pageTypes": [
    {
      "id": "producto",
      "label": "Página de producto",
      "urlPattern": "/(dp|gp/product|gp/aw/d)/[A-Z0-9]{10}",
      "selectors": ["#dp-container #productTitle"],
      "layouts": ["detalle"],
      "autoScroll": false
    }
  ],

  "price": {
    "offscreen": [".a-price:not(.a-text-price) .a-offscreen", ".a-price .a-offscreen"],
    "whole": ".a-price:not(.a-text-price) .a-price-whole",
    "fraction": ".a-price:not(.a-text-price) .a-price-fraction",
    "attr": "data-csa-c-price-to-pay"
  },

  "layouts": [
    {
      "id": "search",
      "label": "Resultados de búsqueda",
      "item": "div[data-component-type=\"s-search-result\"]",
      "asinFrom": ["attr", "child", "link"],
      "link": ["[data-cy=\"title-recipe\"] a[href*=\"/dp/\"]", "a.s-no-outline[href*=\"/dp/\"]", "a[href*=\"/dp/\"]", "[data-cy=\"title-recipe\"] a[href]"],
      "title": ["[data-cy=\"title-recipe\"] a h2 span", "[data-cy=\"title-recipe\"] h2 span", "[data-cy=\"title-recipe\"] h2", "h2 span", "h2"],
      "brand": ["[data-cy=\"title-recipe\"] div.a-row.a-color-secondary :is(h2, h5) span.a-color-base"],
      "image": ["[data-cy=\"image-container\"] img.s-image", "img.s-image"]
    },
    {
      "id": "nuevos",
      "label": "ProductUIRender",
      "item": "li[class*=\"ProductUIRender__grid-item\"]",
      "asinFrom": ["attr", "child", "link"],
      "link": ["[data-cy=\"title-recipe\"] a[href*=\"/dp/\"]", "a.s-no-outline[href*=\"/dp/\"]", "a[href*=\"/dp/\"]", "[data-cy=\"title-recipe\"] a[href]"],
      "title": ["[data-cy=\"title-recipe\"] a h2 span", "[data-cy=\"title-recipe\"] h2 span", "[data-cy=\"title-recipe\"] h2", "h2.a-size-base span", "h2.a-size-mini span"],
      "brand": ["[data-cy=\"title-recipe\"] div.a-row.a-color-secondary :is(h2, h5) span.a-color-base"],
      "image": ["[data-cy=\"image-container\"] picture img", "[data-cy=\"image-container\"] img.s-image", "picture img.s-image", "img.s-image"]
    },
    {
      "id": "antiguos",
      "label": "ProductGridItem",
      "item": "li[class*=\"ProductGridItem__itemOuter\"]",
      "asinFrom": ["link"],
      "link": ["a[title][href*=\"/dp/\"]", "a[href*=\"/dp/\"]"],
      "title": ["a[title][href*=\"/dp/\"]", "h2", "[data-testid=\"product-title\"]"],
      "brand": [],
      "image": ["picture img[data-testid=\"image\"]", "picture img", "img[data-testid=\"image\"]", "img"],
      "priceWhole": ["[class*=\"Price__whole\"]"],
      "priceFraction": ["[class*=\"Price__fractional\"]"]
    },
    {
      "id": "showcases",
      "label": "ProductShowcase",
      "item": "div[data-testid=\"product-showcase-container\"]",
      "asinFrom": ["csaItemId", "link"],
      "link": ["a[data-testid=\"product-showcase-title\"][href*=\"/dp/\"]", "h2#asin-title a[href*=\"/dp/\"]", "a[href*=\"/dp/\"]"],
      "title": ["a[data-testid=\"product-showcase-title\"]", "h2#asin-title a", "a[class*=\"ProductShowcase__title\"]"],
      "brand": [],
      "image": [
        "[data-testid=\"product-showcase-carousel\"] img[data-testid=\"image\"][data-feature=\"af\"]",
        "[data-testid=\"product-showcase-carousel\"] [role=\"group\"][aria-label^=\"1 /\"] img",
        "[data-testid=\"product-showcase-carousel\"] [role=\"group\"][data-index=\"1\"] img",
        "[data-testid=\"product-showcase-carousel\"] img[data-testid=\"image\"]",
        "img[class*=\"ImageVideoCarousel__image\"]"
      ],
      "priceText": ["[class*=\"price\"]", "[class*=\"Price\"]", "[data-testid*=\"price\"]"]
    },
    {
      "id": "editorial",
      "label": "EditorialTile",
      "item": "div[data-testid=\"editorial-tile-Overlay\"][data-csa-c-item-type=\"asin\"], div[class*=\"EditorialTile__content\"][data-csa-c-item-type=\"asin\"]",
      "asinFrom": ["csaItemId", "link"],
      "link": [
        "a[href*=\"/dp/\"]"
      ],
      "title": [
        "a[title][href*=\"/dp/\"]",
        "[class*=\"EditorialTileProduct__title\"]",
        "h2"
      ],
      "brand": [],
      "image": [
        "[data-testid=\"editorial-tile-product-image\"] img",
        "img[data-testid=\"image\"]",
        "img"
      ],
      "priceWhole": [
        "[class*=\"Price__whole\"]"
      ],
      "priceFraction": [
        "[class*=\"Price__fractional\"]"
      ],
      "priceText": [
        "[data-testid=\"editorial-tile-product-price\"]"
      ]
    },
    {
      "id": "detalle",
      "label": "Página de producto",
      "item": "#dp-container",
      "asinFrom": ["input", "url"],
      "asinInput": ["#addToCart input#ASIN", "input#ASIN"],
      "link": [],
      "title": ["#productTitle", "#title"],
      "brand": ["tr.po-brand td.a-span9 span", "tr.po-brand td.a-span9", "#bylineInfo"],
      "brandPatterns": ["^Visit the (.+?) Store$", "^Visita la tienda (?:de )?(.+?)$", "^Brand:\\s*(.+)$", "^Marca:\\s*(.+)$"],
      "image": ["#landingImage", "#imgTagWrapperId img", "#main-image-container img"],
      "priceRoot": ["#apex_desktop", "#corePriceDisplay_desktop_feature_div", "#corePrice_feature_div"],
      "priceWhole": [".priceToPay .a-price-whole", ".apex-pricetopay-value:not(.a-text-price) .a-price-whole"],
      "priceFraction": [".priceToPay .a-price-fraction", ".apex-pricetopay-value:not(.a-text-price) .a-price-fraction"]
    }
  ],

  "xlsx": {
    "filenamePrefix": "Plantilla_Scraping",
    "ecomerce": "Amazon",
    "seguimiento": "Scraping",
    "condicion": {
      "pattern": "\\b(renewed|refurbished|reacondicionad[oa]s?)\\b",
      "match": "Reacondicionado",
      "default": "Nuevo"
    },
    "imageFormula": "IMAGE({celda})",
    "rowHeight": 60,
    "refColumns": [
      { "header": "ref_grupo", "field": "grupo", "width": 28 },
      { "header": "ref_imagen_link", "field": "imagen", "width": 30 },
      { "header": "ref_imagen", "imageOf": "ref_imagen_link", "width": 12 },
      { "header": "ref_nombre", "field": "nombre", "width": 60 },
      { "header": "ref_marca", "field": "marca", "width": 18 },
      { "header": "ref_precio", "field": "precio", "width": 10 },
      { "header": "ref_duplicado", "field": "duplicado", "width": 26 }
    ]
  },

  "csv": {
    "filenamePrefix": "Plantilla_Scrapping",
    "headers": ["PUBLICAR", "SKU HIJOS", "SKU PADRE", "MARCA", "NOMBRE AMAZON", "NOMBRE PROPUESTO", "CATEGORIA PRINCIPAL", "CATEGORIA SECUNDARIA", "CATEGORIA TERCIARIA", "COD CATEGORIA", "LINK", "LINK DE IMAGEN", "IMAGEN", "PESO APROX", "PRECIO USD", "PRECIO PEN S/", "PRECIO COMPETENCIA", "STOCK SCRAPING", "PRECIO SCRAPING", "PRECIO FIJO", "SUBIDO A SISTEMA", "SUBIDO WEB", "SUBIDO RIPLEY", "SUBIDO AGORA", "SUBIDO JUNTOZ"],
    "fields": {
      "SKU PADRE": "asin",
      "MARCA": "marca",
      "NOMBRE AMAZON": "nombre",
      "CATEGORIA PRINCIPAL": "categoria",
      "CATEGORIA SECUNDARIA": "categoriaSecundaria",
      "CATEGORIA TERCIARIA": "categoriaTerciaria",
      "COD CATEGORIA": "codCategoria",
      "LINK": "link",
      "LINK DE IMAGEN": "imagen",
      "PRECIO USD": "precio"
    },
    "defaults": {
      "PESO APROX": "1"
    }
  }
}
