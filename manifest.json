{
  "manifest_version": 3,
  "name": "COMPRAFACIL Scraper",
  "version": "1.14.5",
  "description": "Extrae productos de Amazon, Michael Kors, Sephora, Marc Jacobs y Kate Spade y los exporta a la plantilla de scraping de COMPRAFACIL (xlsx).",
  "permissions": ["activeTab", "scripting", "storage", "alarms", "downloads", "notifications", "unlimitedStorage"],
  "host_permissions": ["https://*.amazon.com/*", "https://*.michaelkors.com/*", "https://*.sephora.com/*", "https://*.marcjacobs.com/*", "https://www.katespade.com/*","https://raw.githubusercontent.com/*"],
  "optional_host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "src/background/background.js",
    "type": "module"
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "COMPRAFACIL Scraper",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png"
    }
  },
  "options_page": "src/options/options.html"
}
